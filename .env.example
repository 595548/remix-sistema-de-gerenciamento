# ====================================================================
# BIBLIOTECA VALDIVA COLAÇO - EMEF DESEMBARGADOR PEDRO DE QUEIROZ
# Modelo de Variáveis de Ambiente (.env.example)
# NUNCA insira chaves reais ou credenciais de produção neste arquivo.
# Para configurar localmente, copie este arquivo como '.env'
# ====================================================================

# GEMINI_API_KEY: Chave para chamadas de IA (se aplicável).
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"

# GOOGLE_BOOKS_API_KEY: Chave opcional para ampliação de cotas na API Google Books
GOOGLE_BOOKS_API_KEY="SUA_CHAVE_GOOGLE_BOOKS_AQUI"

# APP_URL: URL do ambiente ou serviço
APP_URL="http://localhost:3000"

# DJANGO & BACKEND DATABASE CONFIGURATION:
DJANGO_SECRET_KEY="sua_chave_secreta_django_em_producao"
DJANGO_DEBUG="True"
DATABASE_URL="postgres://postgres:postgres@localhost:5432/biblioteca_valdiva_colaco"

# BIBLIOTECA DEFAULT METADATA:
ESCOLA_NOME="EMEF Desembargador Pedro de Queiroz"
BIBLIOTECA_NOME="Biblioteca Valdiva Colaço"
COORDENADORA_NOME="Ada Melo"
PROJETO_AUTORA="Xenia Cardoso"
ANO_LETIVO="2026"
